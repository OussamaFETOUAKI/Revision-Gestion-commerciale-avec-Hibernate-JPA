<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Configuration JDBC MySQL (environnement de production / serveur local) -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/gestion_commerciale?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">password</property>
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

        <!-- Gestion du schéma relationnel -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Affichage et formatage des requêtes SQL -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Déclaration des entités mappées -->
        <mapping class="org.example.entities.Categorie"/>
        <mapping class="org.example.entities.Produit"/>
        <mapping class="org.example.entities.Commande"/>
        <mapping class="org.example.entities.CommandeProduit"/>
        <mapping class="org.example.entities.User"/>
        <mapping class="org.example.entities.Client"/>
        <mapping class="org.example.entities.Fournisseur"/>
    </session-factory>
</hibernate-configuration>
